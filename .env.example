# Copia este archivo como .env y reemplaza los valores. Nunca subas .env al repositorio.
# Usa contraseñas alfanuméricas (el script de inicialización de PostgreSQL las inserta en SQL).

# --- PostgreSQL: superusuario y un usuario por servicio (cada uno solo accede a su base de datos) ---
POSTGRES_PASSWORD=change_me
AUTH_DB_PASSWORD=change_me_auth
ORDER_DB_PASSWORD=change_me_order
INVENTORY_DB_PASSWORD=change_me_inventory
PAYMENT_DB_PASSWORD=change_me_payment
NOTIFICATION_DB_PASSWORD=change_me_notification
SHIPPING_DB_PASSWORD=change_me_shipping

# --- JWT: clave compartida de al menos 32 bytes. Genera una con: openssl rand -base64 48 ---
JWT_SECRET=change_me_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION=1h

# --- Administrador inicial (lo crea auth-service al arrancar si no existe) ---
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=ChangeMe123

# --- Simulador de pagos ---
# Pedidos por encima de este importe se rechazan (sirve para probar la compensación de la saga)
PAYMENT_APPROVAL_LIMIT=1000.00
# Probabilidad (0-1) de fallo transitorio de la pasarela: muestra reintentos y DLT en Kafka UI
PAYMENT_TRANSIENT_FAILURE_RATE=0.0

# --- Puertos publicados ---
GATEWAY_PORT=8080
KAFKA_UI_PORT=8090
KAFKA_EXTERNAL_PORT=9094
POSTGRES_PORT=5432
